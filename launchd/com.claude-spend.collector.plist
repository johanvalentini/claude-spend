<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claude-spend.collector</string>
    <key>ProgramArguments</key>
    <array>
        <string>__UV__</string>
        <string>run</string>
        <string>--project</string>
        <string>__PROJECT__</string>
        <string>claude-spend</string>
        <string>collector</string>
        <string>--log-file</string>
        <string>__HOME__/Library/Logs/claude-spend-collector.log</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__PROJECT__</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin:__HOME__/.local/bin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>5</integer>
    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/claude-spend-collector.stderr.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
